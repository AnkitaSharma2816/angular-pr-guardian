{
  "name": "angular-pr-guardian",
  "version": "1.0.0",
  "description": "🛡️ Angular 20+ Migration Readiness Tool - Automatically scan Angular projects for deprecated APIs and get migration recommendations",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "angular-pr-guardian": "./dist/cli.js",
    "apg": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "clean": "node -e \"try{require('fs').rmSync('dist',{recursive:true})}catch(e){}\"",
    "prebuild": "npm run clean",
    "build": "tsc",
    "start": "node dist/cli.js",
    "dev": "ts-node src/cli.ts",
    "prepublishOnly": "npm run build",
    "test": "echo \"No tests yet\"",
    "postversion": "git push && git push --tags"
  },
  "keywords": [
    "angular",
    "migration",
    "angular-migration",
    "angular-upgrade",
    "angular-20",
    "angular-standalone",
    "angular-signals",
    "code-review",
    "linting",
    "angular-best-practices",
    "angular-cli",
    "angular-compatibility"
  ],
  "author": {
    "name": "Ankita Sharma",
    "email": "demoankita27@gmail.com",
    "url": "https://github.com/AnkitaSharma2816"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AnkitaSharma2816/angular-pr-guardian.git"
  },
  "bugs": {
    "url": "https://github.com/AnkitaSharma2816/angular-pr-guardian/issues"
  },
  "homepage": "https://github.com/AnkitaSharma2816/angular-pr-guardian#readme",
  "engines": {
    "node": ">=16.0.0"
  },
  "dependencies": {
    "chalk": "^4.1.2",
    "commander": "^11.0.0",
    "glob": "^10.3.0",
    "ora": "^5.4.1",
    "ts-morph": "^21.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.0.0"
  }
}